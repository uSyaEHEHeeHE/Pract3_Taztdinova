<Window x:Class="Taztdinova_pract3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Taztdinova_pract3"
        mc:Ignorable="d"
        Title="Заявка на ремонт техники" Height="550" Width="850"
        MinHeight="450" MinWidth="650"
        Background="#F3F6F8">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="#4A586D" Padding="15,10" Height ="40">
            <TextBlock Text="Заявка на ремонт техники" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#E4EBF1" Padding="15, 10" Height ="30">
            <TextBlock Text="Диагностика не назначена" Foreground="#4A586D" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
        </Border>

        <Border CornerRadius="5" Width="130" Margin="10" Background="White" DockPanel.Dock="Right">
            <StackPanel>
                <TextBlock Text="Действия" HorizontalAlignment="Left" Margin="10" Foreground="#4A586D" FontSize="10" FontWeight="Bold"></TextBlock>
                <Button Width="100" Height="20" HorizontalAlignment="Left" Margin="10, 0, 0, 0" Content="Принять" FontSize="10"></Button>
                <Button Width="100" Height="20" HorizontalAlignment="Left" Margin="10, 5, 0, 0" Content="Печать квитанции" FontSize="10"></Button>
                <Button Width="100" Height="20" HorizontalAlignment="Left" Margin="10, 5, 0, 0" Content="Очистить" FontSize="10"></Button>
                <Button Width="100" Height="20" HorizontalAlignment="Left" Margin="10, 5, 0, 0" Content="Закрыть" FontSize="10"></Button>
                <TextBlock Text="Заявка № 1042" HorizontalAlignment="Left" Margin="10, 10, 5, 5"  FontSize="10"></TextBlock>
                <TextBlock Text="Мастер не назначен" HorizontalAlignment="Left" Margin="10, 0, 0, 0"  FontSize="10"></TextBlock>
            </StackPanel>
        </Border>

        <Border CornerRadius="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10, 10, 10, 10" Background="White">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ФИО клиента" VerticalAlignment="Center" Margin="0,0,8,6" Foreground="#4A586D" FontSize="10" FontWeight="Bold"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Height="20" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Модель" VerticalAlignment="Center" Margin="15,0,8,6" Foreground="#4A586D" FontSize="10" FontWeight="Bold"/>
                    <TextBox Grid.Row="0" Grid.Column="3" Height="20" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Телефон" VerticalAlignment="Center" Margin="0,0,8,6" Foreground="#4A586D" FontSize="10" FontWeight="Bold"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Height="20" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Серийный номер" VerticalAlignment="Center" Margin="15,0,8,6" Foreground="#4A586D" FontSize="10" FontWeight="Bold"/>
                    <TextBox Grid.Row="1" Grid.Column="3" Height="20" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Тип устройства" VerticalAlignment="Center" Margin="0,0,8,6" Foreground="#4A586D" FontSize="10" FontWeight="Bold"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" Height="20" Margin="0,0,0,6" SelectedIndex="0">
                        <ComboBoxItem Content="Ноутбук"></ComboBoxItem>
                        <ComboBoxItem Content="Телефон"></ComboBoxItem>
                        <ComboBoxItem Content="Планшет"></ComboBoxItem>
                        <ComboBoxItem Content="Компьютер"></ComboBoxItem>
                    </ComboBox>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Дата приема" VerticalAlignment="Center" Margin="15,0,8,6" Foreground="#4A586D" FontSize="10" FontWeight="Bold"/>
                    <DatePicker Grid.Row="2" Grid.Column="3" Height="20" Margin="0,0,0,6" FontSize="10"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Производитель" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#4A586D" FontSize="10" FontWeight="Bold"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Height="20"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Состояние корпуса" VerticalAlignment="Center" Margin="15,0,8,0" Foreground="#4A586D" FontSize="10" FontWeight="Bold"/>
                    <ComboBox Grid.Row="3" Grid.Column="3" Height="20" SelectedIndex="0">
                        <ComboBoxItem Content="Без повреждений"></ComboBoxItem>
                        <ComboBoxItem Content="С повреждениями"></ComboBoxItem>
                        <ComboBoxItem Content="Требует осмотра"></ComboBoxItem>
                    </ComboBox>
                </Grid>

                <Grid Grid.Row="1" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>

                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Описание неисправности" Foreground="#4A586D" FontSize="10" FontWeight="Bold" Margin="0, 10"></TextBlock>
                    <TextBox Grid.Row="1" Height="100" MinHeight="50"/>
                </Grid>

                <StackPanel Grid.Row="2" >
                    <TextBlock Text="Комплектность"  Foreground="#4A586D" FontSize="10" FontWeight="Bold" Margin="10"></TextBlock>
                    <WrapPanel Orientation="Horizontal">
                        <CheckBox Content="Зарядное устройство" FontSize="10" Margin="10"/>
                        <CheckBox Content="Кабель" FontSize="10" Margin="10"/>
                        <CheckBox Content="Чехол" FontSize="10" Margin="10"/>
                        <CheckBox Content="Коробка" FontSize="10" Margin="10"/>
                        <CheckBox Content="Документы" FontSize="10" Margin="10"/>
                        <CheckBox Content="Дополнительный аккумулятор" FontSize="10" Margin="10"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</Window>
